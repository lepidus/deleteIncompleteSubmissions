msgid "plugins.generic.deleteIncompleteSubmissions.displayName"
msgstr "Unvollständigen Beitrag löschen"

msgid "plugins.generic.deleteIncompleteSubmissions.description"
msgstr "Löscht in einem einzigen geprüften und bestätigten Vorgang alle unvollständigen Beiträge, die länger als die festgelegte Anzahl von Tagen inaktiv sind."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.description"
msgstr "Legen Sie fest, wie viele Tage ein unvollständiger Beitrag inaktiv sein muss, um für die Löschung infrage zu kommen. Alle infrage kommenden Beiträge werden zur Prüfung aufgelistet und die gesamte Liste wird nach Ihrer Bestätigung auf einmal gelöscht."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.title"
msgstr "Bevor Sie fortfahren:"

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.one"
msgstr "Kurze Inaktivitätszeiträume können Beiträge erfassen, an denen die Autor*innen noch arbeiten."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.two"
msgstr "Es wird nichts automatisch gelöscht: Beiträge werden nur gelöscht, wenn Sie diese Aktion ausführen; wiederholen Sie sie, wann immer eine Bereinigung nötig ist."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.three"
msgstr "Beiträge mit einer veröffentlichten oder geplanten Publikation oder mit einer zugewiesenen DOI werden nie gelöscht, und das wird unmittelbar vor dem Löschen erneut geprüft."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion"
msgstr "Beiträge löschen..."

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelPrefix"
msgstr "Alle unvollständigen Beiträge ohne Aktivität seit mehr als"

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelSuffix"
msgstr "Tagen."

msgid "plugins.generic.deleteIncompleteSubmissions.validation.integer"
msgstr "Der Wert für die Löschfrist muss eine positive ganze Zahl sein."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.action"
msgstr "Löschungen in der Vorschau anzeigen"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.title"
msgstr "Zur Löschung geeignete Einreichungen"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.id"
msgstr "ID"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.submissionTitle"
msgstr "Titel"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.status"
msgstr "Status"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.lastActivity"
msgstr "Letzte Aktivität"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.empty"
msgstr "Keine Einreichung erfüllt alle sicheren Löschkriterien."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.confirmation"
msgstr "Prüfen Sie die Liste sorgfältig. Nur diese Einreichungen werden erneut geprüft und dauerhaft gelöscht."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.deleteConfirmed"
msgstr "Aufgelistete Einreichungen löschen"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.expired"
msgstr "Die Vorschau ist abgelaufen, die Löschfrist wurde geändert oder eine neuere Vorschau wurde möglicherweise in einem anderen Tab erstellt. Erstellen Sie vor dem Löschen eine neue Vorschau."
