msgid "plugins.generic.deleteIncompleteSubmissions.displayName"
msgstr "Supprimer les soumissions incomplètes"

msgid "plugins.generic.deleteIncompleteSubmissions.description"
msgstr "Supprime, en une seule opération vérifiée et confirmée, toutes les soumissions incomplètes inactives depuis plus longtemps que le seuil défini."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.description"
msgstr "Définissez le nombre de jours d'inactivité à partir duquel une soumission incomplète devient éligible à la suppression. Toutes les soumissions éligibles sont listées pour vérification, puis la liste entière est supprimée en une fois, après votre confirmation."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.title"
msgstr "Avant de continuer :"

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.one"
msgstr "Des périodes d'inactivité courtes peuvent concerner des soumissions que les auteurs et autrices sont encore en train de remplir."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.two"
msgstr "Rien n'est supprimé automatiquement : les soumissions ne sont supprimées que lorsque vous exécutez cette action ; répétez-la chaque fois qu'un nettoyage est nécessaire."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.three"
msgstr "Les soumissions ayant une publication publiée ou programmée, ou un DOI attribué, ne sont jamais supprimées, et cela est vérifié à nouveau juste avant la suppression."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion"
msgstr "Supprimer les soumissions..."

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelPrefix"
msgstr "Supprimer toutes les soumissions incomplètes sans activité depuis plus de"

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelSuffix"
msgstr "jours."

msgid "plugins.generic.deleteIncompleteSubmissions.validation.integer"
msgstr "La valeur du seuil de suppression doit être un entier positif."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.action"
msgstr "Prévisualiser les suppressions"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.title"
msgstr "Soumissions admissibles à la suppression"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.id"
msgstr "ID"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.submissionTitle"
msgstr "Titre"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.status"
msgstr "Statut"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.lastActivity"
msgstr "Dernière activité"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.empty"
msgstr "Aucune soumission ne répond à tous les critères de suppression sécurisée."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.confirmation"
msgstr "Examinez attentivement la liste. Seules ces soumissions seront revalidées et supprimées définitivement."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.deleteConfirmed"
msgstr "Supprimer les soumissions répertoriées"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.expired"
msgstr "La prévisualisation a expiré, le seuil a changé ou une prévisualisation plus récente a été générée, peut-être dans un autre onglet. Générez-en une nouvelle avant toute suppression."
