msgid "plugins.generic.deleteIncompleteSubmissions.displayName"
msgstr "Cancellare gli Proposte incompleti"

msgid "plugins.generic.deleteIncompleteSubmissions.description"
msgstr "Elimina, in un'unica operazione verificata e confermata, tutte le proposte incomplete inattive da più giorni della soglia impostata."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.description"
msgstr "Imposta dopo quanti giorni di inattività una proposta incompleta diventa eleggibile per l'eliminazione. Tutte le proposte eleggibili vengono elencate per la tua verifica e l'intero elenco viene eliminato in una sola volta, dopo la tua conferma."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.title"
msgstr "Prima di continuare:"

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.one"
msgstr "Periodi di inattività brevi possono includere proposte che gli autori stanno ancora compilando."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.two"
msgstr "Nulla viene eliminato automaticamente: le proposte vengono eliminate solo quando esegui questa azione; ripetila ogni volta che serve una pulizia."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.three"
msgstr "Le proposte con una pubblicazione pubblicata o programmata, o con un DOI assegnato, non vengono mai eliminate, e questo viene verificato di nuovo immediatamente prima dell'eliminazione."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion"
msgstr "Cancellare gli Proposte..."

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelPrefix"
msgstr "Elimina tutte le proposte incomplete senza attività da più di"

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelSuffix"
msgstr "giorni."

msgid "plugins.generic.deleteIncompleteSubmissions.validation.integer"
msgstr "Il valore della soglia di eliminazione deve essere un numero intero positivo."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.action"
msgstr "Anteprima delle eliminazioni"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.title"
msgstr "Proposte idonee all'eliminazione"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.id"
msgstr "ID"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.submissionTitle"
msgstr "Titolo"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.status"
msgstr "Stato"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.lastActivity"
msgstr "Ultima attività"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.empty"
msgstr "Nessuna proposta soddisfa tutti i criteri di eliminazione sicura."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.confirmation"
msgstr "Controlla attentamente l'elenco. Solo queste proposte saranno convalidate di nuovo ed eliminate definitivamente."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.deleteConfirmed"
msgstr "Elimina le proposte elencate"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.expired"
msgstr "L'anteprima è scaduta, la soglia è cambiata o è stata generata un'anteprima più recente, forse in un'altra scheda. Generane una nuova prima di eliminare."
