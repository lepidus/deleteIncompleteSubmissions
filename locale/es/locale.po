msgid "plugins.generic.deleteIncompleteSubmissions.displayName"
msgstr "Eliminar envíos incompletos"

msgid "plugins.generic.deleteIncompleteSubmissions.description"
msgstr "Elimina, en una sola operación revisada y confirmada, todos los envíos incompletos que llevan más días inactivos que el límite definido."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.description"
msgstr "Defina cuántos días debe llevar inactivo un envío incompleto para ser elegible para su eliminación. Todos los envíos elegibles se listan para su revisión y la lista completa se elimina de una vez, tras su confirmación."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.title"
msgstr "Antes de continuar:"

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.one"
msgstr "Los períodos de inactividad cortos pueden alcanzar envíos que sus autores todavía están completando."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.two"
msgstr "Nada se elimina automáticamente: los envíos solo se eliminan cuando usted ejecuta esta acción; repítala siempre que necesite una limpieza."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.three"
msgstr "Los envíos con una publicación publicada o programada, o con un DOI asignado, nunca se eliminan, y esto se comprueba de nuevo inmediatamente antes de la eliminación."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion"
msgstr "Eliminar envíos..."

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelPrefix"
msgstr "Eliminar todos los envíos incompletos sin actividad durante más de"

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelSuffix"
msgstr "días."

msgid "plugins.generic.deleteIncompleteSubmissions.validation.integer"
msgstr "El valor del límite de exclusión debe ser un número entero positivo."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.action"
msgstr "Previsualizar eliminaciones"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.title"
msgstr "Envíos elegibles para eliminación"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.id"
msgstr "ID"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.submissionTitle"
msgstr "Título"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.status"
msgstr "Estado"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.lastActivity"
msgstr "Última actividad"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.empty"
msgstr "Ningún envío cumple todos los criterios de eliminación segura."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.confirmation"
msgstr "Revise la lista con atención. Solo estos envíos se volverán a validar y se eliminarán permanentemente."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.deleteConfirmed"
msgstr "Eliminar los envíos de la lista"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.expired"
msgstr "La previsualización caducó, cambió el límite de eliminación o se generó una más reciente, posiblemente en otra pestaña. Genere una nueva antes de eliminar envíos."
