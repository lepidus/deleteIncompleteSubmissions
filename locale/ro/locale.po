msgid "plugins.generic.deleteIncompleteSubmissions.displayName"
msgstr "Ștergeți înregistrările incomplete"

msgid "plugins.generic.deleteIncompleteSubmissions.description"
msgstr "Șterge, într-o singură operațiune verificată și confirmată, toate înregistrările incomplete inactive de mai multe zile decât pragul stabilit."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.description"
msgstr "Stabiliți câte zile trebuie să fie inactivă o înregistrare incompletă pentru a fi eligibilă pentru ștergere. Toate înregistrările eligibile sunt listate pentru verificare, iar întreaga listă este ștearsă dintr-o dată, după confirmarea dumneavoastră."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.title"
msgstr "Înainte de a continua:"

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.one"
msgstr "Perioadele scurte de inactivitate pot include înregistrări pe care autorii încă le completează."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.two"
msgstr "Nimic nu este șters automat: înregistrările sunt șterse doar când efectuați această acțiune; repetați-o ori de câte ori este nevoie de o curățare."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion.warning.item.three"
msgstr "Înregistrările cu o publicație publicată sau programată, sau cu un DOI atribuit, nu sunt niciodată șterse, iar acest lucru este verificat din nou imediat înainte de ștergere."

msgid "plugins.generic.deleteIncompleteSubmissions.deletion"
msgstr "Ștergere înregistrări..."

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelPrefix"
msgstr "Șterge toate transmiterile incomplete fără activitate de mai mult de"

msgid "plugins.generic.deleteIncompleteSubmissions.deletionLabelSuffix"
msgstr "zile."

msgid "plugins.generic.deleteIncompleteSubmissions.validation.integer"
msgstr "Valoarea pragului de ștergere trebuie să fie un număr întreg pozitiv."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.action"
msgstr "Previzualizați ștergerile"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.title"
msgstr "Înregistrări eligibile pentru ștergere"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.id"
msgstr "ID"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.submissionTitle"
msgstr "Titlu"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.status"
msgstr "Stare"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.lastActivity"
msgstr "Ultima activitate"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.empty"
msgstr "Nicio înregistrare nu îndeplinește toate criteriile de ștergere în siguranță."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.confirmation"
msgstr "Verificați lista cu atenție. Numai aceste înregistrări vor fi revalidate și șterse definitiv."

msgid "plugins.generic.deleteIncompleteSubmissions.preview.deleteConfirmed"
msgstr "Ștergeți înregistrările enumerate"

msgid "plugins.generic.deleteIncompleteSubmissions.preview.expired"
msgstr "Previzualizarea a expirat, pragul s-a modificat sau a fost generată una mai nouă, posibil într-o altă filă. Generați o previzualizare nouă înainte de ștergere."
